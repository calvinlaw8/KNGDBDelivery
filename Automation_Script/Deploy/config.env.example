# 交付五部署配置模板
# 使用前复制为 config.env，并按目标现场修改 IP、主机名和凭据：
#   cp config.env.example config.env
# config.env 已被 .gitignore 忽略，禁止提交真实密码。

_CFG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "${_CFG_DIR}/../.." && pwd)"

PKG_ROOT="${PROJECT_ROOT}/Automation_Script/Deploy/pkg"
LOCAL_DB_PKG_DIR="${PROJECT_ROOT}/离线安装包"

# Ansible 管理节点
ANSIBLE_NODE_IP="CHANGE_ME"
ANSIBLE_NODE_USER="CHANGE_ME"
ANSIBLE_NODE_PASS="CHANGE_ME"
ANSIBLE_NODE_HOSTNAME="CHANGE_ME"

LOCAL_PLAYBOOK_DIR="${PROJECT_ROOT}/Automation_Script/Deploy/playbooks"
REMOTE_PLAYBOOK_DIR="/home/sysadmin/playbooks"
LOCAL_PAYLOAD_VALIDATOR="${PROJECT_ROOT}/Automation_Script/Deploy/validate_deb_payloads.sh"
REMOTE_PAYLOAD_VALIDATOR="/home/sysadmin/validate_deb_payloads.sh"
REMOTE_PKG_DIR="/home/sysadmin/pkg"

# DB 服务器拓扑：每组必须有 3 台，数组顺序必须与主机名一一对应
REDIS_IPS=(CHANGE_ME CHANGE_ME CHANGE_ME)
REDIS_HOSTNAMES=(CHANGE_ME CHANGE_ME CHANGE_ME)

RABBITMQ_IPS=(CHANGE_ME CHANGE_ME CHANGE_ME)
RABBITMQ_HOSTNAMES=(CHANGE_ME CHANGE_ME CHANGE_ME)

MONGODB_IPS=(CHANGE_ME CHANGE_ME CHANGE_ME)
MONGODB_HOSTNAMES=(CHANGE_ME CHANGE_ME CHANGE_ME)

MYSQL_IPS=(CHANGE_ME CHANGE_ME CHANGE_ME)
MYSQL_HOSTNAMES=(CHANGE_ME CHANGE_ME CHANGE_ME)

DB_IPS=("${REDIS_IPS[@]}" "${RABBITMQ_IPS[@]}" "${MONGODB_IPS[@]}" "${MYSQL_IPS[@]}")
DB_HOSTNAMES=("${REDIS_HOSTNAMES[@]}" "${RABBITMQ_HOSTNAMES[@]}" "${MONGODB_HOSTNAMES[@]}" "${MYSQL_HOSTNAMES[@]}")

DB_USER="CHANGE_ME"
DB_PASS="CHANGE_ME"